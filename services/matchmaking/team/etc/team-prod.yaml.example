# Pandora team 生产配置【模板】。cp team-prod.yaml.example team-prod.yaml 填真值后部署。
# ⚠️ 真实 team-prod.yaml 被 services/.gitignore 忽略,只提交本 .example。
# 与 dev 差异:删 enable_reflection;timeout 收紧;redis 加密码;kafka 真实 brokers。

server:
  grpc:
    network: tcp
    addr: ":20010"
    enable_rate_limit: true   # 压测前审核门禁-A:BBR 自适应限流(客户端面服务 prod 必开,过载按 CPU/inflight/RT 丢负载)
    timeout: "5s"
    # enable_reflection 不写 = false
  http:
    network: tcp
    addr: ":21010"

node:
  node_id: 1
  redis_client:
    host: "__REDIS_HOST__:6379"
    password: "__REDIS_PASSWORD__"
    db: 0
    dial_timeout: "2s"
    read_timeout: "1s"
    write_timeout: "1s"

kafka:
  brokers: ["__KAFKA_BROKER_1__:9092", "__KAFKA_BROKER_2__:9092"]
  dial_timeout: "2s"
  write_timeout: "5s"
  idempotent: true

snowflake:
  epoch: 1773446400
  node_bits: 17
  step_bits: 15

team:
  invite_ttl: "60s"
  disbanded_retention: "5m"
  active_ttl: "60m"
  max_members: 5
  optimistic_retry: 3
  # 离队/踢人联动撤销匹配票据(弱依赖,留空则不联动)
  matchmaker_addr: "matchmaker.pandora.svc.cluster.local:20011"
  # team→login 内部批量解析角色展示编号；密钥须与 login 入站配置一致且独立随机。
  player_no_resolver_addr: "login.pandora.svc.cluster.local:20001"
  player_no_resolver_auth_secret: "__PLAYER_NO_RESOLVE_AUTH_SECRET_32B_CHANGE_ME__"
  player_no_resolver_auth_audience: "login:player-no"
  # team→player 内部批量解析角色名；不得复用 DS callback 或玩家 JWT 密钥。
  player_name_resolver_addr: "player.pandora.svc.cluster.local:20002"
  player_name_resolver_auth_secret: "__PLAYER_NAME_RESOLVE_AUTH_SECRET_32B_CHANGE_ME__"
  player_name_resolver_auth_audience: "player:name"
  # team→matchmaker 调 ResolvePlayerMatchContext 的服务鉴权(caller 固定签 "team")。
  # 入队闸门是 fail-closed 的:这把密钥漏配 → 招募列表恒空 + 申请入队恒失败。
  # 必须等于 matchmaker 的 match.team_resume_auth_secret,且与 login 那把不同。
  # 生产环境请换成 ≥32 字节的随机密钥,勿沿用 dev 示例值。
  match_resume_auth_secret: "CHANGE-ME-team-resume-auth-key-32bytes-min"
  match_resume_auth_audience: "matchmaker:5v5_ranked"
  # ── 反方向:验 matchmaker 调 BeginTeamMatch / EndTeamMatch(A-13)────────────────
  # ⚠️ 必须与上面那把**不同**(那把是 team 签出站用的,共用等于互相可冒充)。
  # 对应 matchmaker 的 team_call_auth_secret / team_call_auth_audience。
  match_call_auth_secret: "CHANGE-ME-match-call-auth-key-32bytes-min"
  match_call_auth_audience: "team"
  # ⚠️ 首次上线保持 false(观察期):先确认 matchmaker 已**全量**滚上带签名的版本
  # (日志 team_match_call_auth_observed 归零),再单独发一次配置把它翻 true。
  # 直接上 true 会在共存窗口里把还没签名的旧 matchmaker 全部拒掉。
  match_call_auth_require: false

  # 离线观察的 locator 来源（真实 K8s Service gRPC 端口）。
  locator_addr: "player-locator.pandora.svc.cluster.local:20006"
  # 当前必须保持关闭：team 成员写与 StartMatch 尚无共用 roster fence，设为 true 会在
  # 启动时 fail-fast。仅打开 locator departure_event 不能消除跨服务 TOCTOU。
  # threshold=180s 的推导见 internal/conf/conf.go OfflineLeaveConf 注释:低于它会踢掉
  # 本来能回来的玩家(重连链路本身就要 30~60s),弱网(地铁/隧道)还要再留余量。
  offline_leave:
    enabled: false
    threshold: "180s"
    check_interval: "15s"
    budget: 200
    kafka_partitions: 3

# 会话现行性门(R5 复审 P0-1,INC-20260722-004):生产强制档,顶号后旧 JWT 立即失效;
# 权威端点漏配拒启,权威不可达 fail-closed。与 gen_cluster_config.ps1 -Prod 产物一致。
session_gate:
  require: true
