# Pandora guild 服务生产配置模板(2026-06-27)。
#
# 真实部署时复制为 guild-prod.yaml 并按集群实际地址 / 密码填写,**不要提交真实密码到 git**。
# - gRPC :20008 / HTTP :21008(仅 /metrics)
# - 公会(GuildService)+ 临时群(GroupService)同进程
# - prod: enable_reflection 不写(零值 false,关 reflection 减少攻击面)

server:
  grpc:
    network: tcp
    addr: ":20008"
    enable_rate_limit: true   # 压测前审核门禁-A:BBR 自适应限流(客户端面服务 prod 必开,过载按 CPU/inflight/RT 丢负载)
    timeout: "3s"
  http:
    network: tcp
    addr: ":21008"

node:
  node_id: 1
  mysql_client:
    dsn: "pandora:__REPLACE_WITH_SECRET__@tcp(mysql:3306)/pandora_social?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci"
    max_open_conns: 64
    max_idle_conns: 16
    conn_max_lifetime: "30m"
    ping_timeout: "3s"
  # 会话权威共享 Redis(pandora:sess,与 login 同库):session_gate 的现行性判定端点,
  # 兼公会资料读缓存。漏配 + require=true 会在启动期 fail-fast 拒启(sessiongate.MustBuild)。
  redis_client:
    host: "__REDIS_HOST__:6379"
    password: "__REDIS_PASSWORD__"
    db: 0
    dial_timeout: "2s"

kafka:
  brokers: ["kafka:9092"]
  group_id: "pandora-guild"
  partition_cnt: 4

guild:
  max_guild_members: 100
  max_group_members: 50
  max_name_len: 24
  # 入会申请 per-player 每分钟频率配额。与 guild-dev.yaml 保持一致;
  # 判据是 `== 0`(负值 = 显式关闭),删掉本行会退回代码默认 10。
  rate_quota_per_min: 60
  player_name_resolver_addr: "player.pandora.svc.cluster.local:20002"
  player_name_resolver_auth_secret: "__GUILD_PLAYER_NAME_RESOLVE_AUTH_SECRET_32B_CHANGE_ME__"
  player_name_resolver_auth_audience: "player:name"
  player_no_resolver_addr: "login.pandora.svc.cluster.local:20001"
  player_no_resolver_auth_secret: "__GUILD_PLAYER_NO_RESOLVE_AUTH_SECRET_32B_CHANGE_ME__"
  player_no_resolver_auth_audience: "login:player-no"

# 会话现行性门(R5 复审 P0-1,INC-20260722-004):客户端面请求 jti 必须等于 login 会话
# 权威当前一代,顶号后旧 JWT 立即失效。生产必须 require: true(强制档:gate 未装配 =
# fail-closed 拒请求;端点漏配 = 启动拒启),否则正常走 Envoy 的旧 JWT 仍可调用
# Guild/Group(R6 复审开放缺口②,本模板补齐)。
session_gate:
  require: true
