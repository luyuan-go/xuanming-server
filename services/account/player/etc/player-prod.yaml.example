# Pandora player 生产配置【模板】。cp player-prod.yaml.example player-prod.yaml 填真值后部署。
# ⚠️ 真实 player-prod.yaml 被 services/.gitignore 忽略,只提交本 .example。
# 与 dev 差异:删 enable_reflection;timeout 收紧;mysql 强密码 + 真实 host;kafka 真实 brokers。

server:
  grpc:
    network: tcp
    addr: ":20002"
    enable_rate_limit: true   # 压测前审核门禁-A:BBR 自适应限流(客户端面服务 prod 必开,过载按 CPU/inflight/RT 丢负载)
    timeout: "5s"
    # enable_reflection 不写 = false
  http:
    network: tcp
    addr: ":21002"

node:
  node_id: 1
  # Redis:会话现行性门只读 login 会话权威 pandora:sess(R5 复审 P0-1,共享实例)。
  redis_client:
    host: "redis:6379"
    db: 0
    dial_timeout: "2s"
  mysql_client:
    dsn: "pandora:__MYSQL_STRONG_PASSWORD__@tcp(__MYSQL_HOST__:3306)/pandora_player?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci"
    max_open_conns: 64
    max_idle_conns: 16
    conn_max_lifetime: "30m"
    ping_timeout: "3s"

kafka:
  brokers: ["__KAFKA_BROKER_1__:9092", "__KAFKA_BROKER_2__:9092"]
  group_id: "pandora-player"
  partition_cnt: 4

# 发布流水线落地的 active 批次；目录缺失或等级表校验失败时 player 拒绝启动。
config_table:
  dir: "/app/configtable/active"

player:
  base_mmr: 1500
  mmr_floor: 0
  default_nickname_prefix: "Player_"
  max_nickname_len: 32
  # team→player ResolvePlayerNames 的独立 request-bound HMAC。
  player_name_resolve_auth_secret: "__PLAYER_NAME_RESOLVE_AUTH_SECRET_32B_CHANGE_ME__"
  player_name_resolve_auth_audience: "player:name"
  hero_selection_enabled: true
  loadout_customize_enabled: true
  consume_topics:
    - "pandora.player.update"
  # 玩家等级经验唯一读取 config_table/player_level_exp，不在 YAML 维护第二份曲线。
  # 当前策划表仍标注为联调占位数值；正式确认前保持 false。
  experience_enabled: false
  max_exp_per_grant: 1000000
  push_outbox_interval: "1s"
  push_outbox_batch: 128
  # 保留期清理(§9.24):生产**留空 retention_mode = report_only** —— janitor 照常跑,
  # 每小时统计各表超期行数并打 WARN(db_retention_pending_not_deleted)+
  # pandora_db_retention_pending_rows gauge,一行都不删。库会继续增长,靠这两个信号
  # (以及 `dbcheck -pending`)让人判断何时开删。
  #
  # 开删是独立显式动作,需要两道闸同时开:
  #   ① retention_mode: "delete"
  #   ② 对应组的前置条件确认:exp_history_cleanup_enabled(上游 battle_result progress
  #      出箱必须先有小于留存期的有界重试)/ history_cleanup_enabled(kafka retention 与
  #      授予补扫窗口必须先小于留存期)。
  # 前置条件未满足就开删 = 迟到重放重复入账经验 / MMR / 点数 / 技能卡,且不可逆。
  # 首次开删前先跑 `dbcheck -pending` 看积压规模,低峰期发布。
  # retention_mode: "delete"
  # exp_history_cleanup_enabled: true
  # history_cleanup_enabled: true
  #
  # 经验幂等收据留存期(默认/下限 7d,须覆盖 battle_result progress 出箱最长重试窗)。
  # report_only 下它同时是"多少行算待清理"的报告口径。
  exp_history_retention: "168h"
  # mmr_history / attr_point_grants / talent_point_grants / skill_card_grants 留存天数
  # (默认 90,钳 [30,90];报告与实删共用同一值)
  history_retention_days: 90

# 会话现行性门(R5 复审 P0-1,INC-20260722-004):生产强制档,顶号后旧 JWT 立即失效;
# 权威端点漏配拒启,权威不可达 fail-closed。与 gen_cluster_config.ps1 -Prod 产物一致。
session_gate:
  require: true

# DS 回调令牌校验(verify-only)。player 只持校验材料,不持任何签发私钥,也不持玩家签票密钥;
# 普通 stable/canary 发布不轮换本 secret(轮换走 additional_secrets 三段式,见 pkg/config DSAuthConf)。
#
# 生产直接 enforce:GetLoadout 经 Envoy DS 面(:8444)暴露且该监听器无 jwt_authn,
# 不 enforce 等于把任意玩家的出战快照(装备实例 ID / 词条 / 天赋)开放给能连到该端口的任何进程。
# 切 enforce 的前置条件与灰度顺序见 docs/design/decision-revisit-ds-callback-auth.md。
#
# secret 必须与 ds_allocator / hub_allocator 的 ds_auth.secret 同值,且与玩家面 jwt keyset 无交集。
ds_auth:
  mode: "enforce"
  issuer: "pandora-ds-control"
  audience: "pandora-ds"
  secret: "__DS_CALLBACK_HS256_SECRET_AT_LEAST_32_BYTES__"
